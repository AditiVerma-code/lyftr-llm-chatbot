# ==============================================================================
# Lyftr AI Chatbot - Environment Configuration
# ==============================================================================

# Comma-separated key pool, at least 2 keys. Key ids are key_1, key_2, ... in this order.
# Replace with your real provider keys (e.g., Gemini, OpenAI, Groq, etc.)
LLM_API_KEYS=your_first_api_key_here,your_second_api_key_here

# SQLite database file location (Docker volume mounts at /data)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated allowed CORS origins for the frontend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*

# Enables X-Simulate-Failure request header for failover demonstrations
ENABLE_FAILURE_SIMULATION=true

# LiteLLM model identifier to use for completions
DEFAULT_MODEL=gemini/gemini-2.0-flash

# Default system prompt for active sessions
DEFAULT_SYSTEM_PROMPT=You are a helpful and concise AI assistant.

# Set to true to enable mock responses for offline local testing without live credits
MOCK_LLM=false

# Frontend API base URL (used during frontend build/containerization)
VITE_API_BASE_URL=http://localhost:8000
